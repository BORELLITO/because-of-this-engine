# Set this in your shell or secret manager. Never commit a real API key.
GEMINI_API_KEY=replace_with_your_own_key

# Gemini image API has no free tier. Keep this unset unless you intentionally approve billing.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_SIZE=1K
GEMINI_IMAGE_MAX_REQUESTS=6
# GEMINI_ALLOW_IMAGE_BILLING=1
# GEMINI_ALLOW_PREMIUM_IMAGE=1

# Free-first image provider: NASA Image and Video Library (no API key).
# This is the default because it avoids billing and account dependencies.
IMAGE_PROVIDER=nasa
# Optional generative provider. Use only when explicitly configured.
# IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=replace_with_your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=replace_with_your_cloudflare_api_token
IMAGE_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0
