# Runtime configuration for Because of This Engine v2.
# Keep real credentials in the secret manager; never commit them.
GEMINI_API_KEY=replace_with_your_own_key

# Optional narration transport override. The production default is REST streaming.
# GEMINI_TTS_TRANSPORT=rest_stream
# GEMINI_TTS_TIMEOUT_SECONDS=180

# Google Drive OAuth is injected by GitHub Actions secrets:
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET
# GOOGLE_REFRESH_TOKEN

# The render workflow receives the approved episode manifest and Drive folder
# through its dispatch inputs; no image-provider configuration is supported.
