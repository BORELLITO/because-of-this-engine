# Set this in your shell or secret manager. Never commit a real API key.
GEMINI_API_KEY=replace_with_your_own_key

# Gemini image API has no free tier. Keep this unset unless you intentionally approve billing.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_SIZE=1K
GEMINI_IMAGE_MAX_REQUESTS=6
# GEMINI_ALLOW_IMAGE_BILLING=1
# GEMINI_ALLOW_PREMIUM_IMAGE=1
