  "title": {
    "working": "THE SIGNAL THAT COULD HAVE STARTED WORLD WAR III",
    "alternate": [
      "THE NIGHT THE MACHINE LIED",
      "FIVE MISSILES"
    ],
    "title_risk_note": "Avoid stating that Petrov certainly saved the world; the historical record supports credited or potentially prevented wording."
  },
  "premise": "A Soviet early-warning system reported five incoming American nuclear missiles. Stanislav Petrov refused to convert an unconfirmed signal into a confirmed attack.",
  "central_question": "Would one officer trust the machine, or the evidence that the machine was wrong?",
  "audience_promise": "A real nuclear false alarm, one human judgment under impossible pressure, and the quiet consequence of refusing to escalate uncertainty.",
  "human_anchor": "Lieutenant Colonel Stanislav Petrov",
  "irreversible_choice": "Report the alert as false instead of passing it forward as a confirmed attack.",
  "causal_chain": [
    "The Soviet early-warning system reports an American missile launch.",
    "The system escalates the report from one missile to five.",
    "Ground radar does not confirm the satellite warning.",
    "Petrov reports the alarm as false.",
    "No missiles arrive.",
    "The signal is traced to sunlight reflected from high clouds.",
    "The system failure is exposed and Petrov's career suffers."
  ],
  "factual_guardrails": [
    "Use 'reported' or 'indicated' for the missiles; do not present the false alert as a real launch.",
    "Use 'could have moved the command toward retaliation', not 'Petrov definitely stopped a nuclear war'.",
    "The episode must distinguish Petrov's documented decision from later public mythology.",
    "Representational visuals must not be labeled as literal archival footage."
  ],
