    "beats": [
      {
        "beat_id": "beat-001",
        "text": "At 2:14 a.m., a hospital elevator stopped at a floor the building did not have."
      },
      {
        "beat_id": "beat-002",
        "text": "The guard on duty checked the panel. There was no button for thirteen. The system log still showed the doors open for forty-seven seconds."
      },
      {
        "beat_id": "beat-003",
        "text": "Then the camera found a corridor beyond the doors: narrow concrete, one red emergency lamp, and no sign of construction. Elias stepped forward. The feed went black."
      },
      {
        "beat_id": "beat-004",
        "text": "By morning, maintenance had found no thirteenth landing. The control board was replaced. The elevator was chained shut."
      },
      {
        "beat_id": "beat-005",
        "text": "At 2:14 the next night, the display returned to thirteen."
      },
      {
        "beat_id": "beat-006",
        "text": "This time, the camera stayed on. A figure in Elias's uniform stood at the far end of the red corridor."
      },
      {
        "beat_id": "beat-007",
        "text": "The lobby monitor showed Elias outside the elevator, watching. Then the system added a second passenger."
      },
      {
        "beat_id": "beat-008",
        "text": "The indicator began descending below the basement. No one pressed a button."
      }
    ]
  },
