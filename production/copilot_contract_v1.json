{
  "schema_version": "1.0",
  "copilot_id": "because_of_this_copilot",
  "canonical_engine": "production/canonical_entrypoint.py",
  "canonical_guard": "production/v21_singleton_guard.py",
  "canonical_state_file": "ESTADO_ATUAL.md",
  "serialization": {
    "mode": "GLOBAL_SINGLE_CANONICAL_ENGINE",
    "workflow_concurrency_group": "because-of-this-canonical-engine",
    "parallel_production_runs": false,
    "cancel_in_progress": false,
    "memory_sync_before_and_after": true,
    "max_mutating_subagents": 1,
    "subagent_dispatch": "SEQUENTIAL_ISOLATED_ARTIFACT"
  },
  "states": [
    "IDLE",
    "INTAKE",
    "RECONCILING_MEMORY",
    "RESEARCH",
    "FACTUAL_REVIEW",
    "EDITORIAL_REVIEW",
    "RIGHTS_REVIEW",
    "VISUAL_REVIEW",
    "TIMELINE_PREFLIGHT",
    "ENGINE_QUEUE",
    "ENGINE_RUNNING",
    "QA",
    "DELIVERY_READY",
    "BLOCKED",
    "FAIL_CLOSED"
  ],
  "subagents": [
    {
      "id": "research_analyst",
      "order": 1,
      "artifact": "research_card",
      "approval_domain": "sources",
      "can_start_engine": false
    },
    {
      "id": "factual_reviewer",
      "order": 2,
      "artifact": "factual_receipt",
      "approval_domain": "factuality",
      "can_start_engine": false
    },
    {
      "id": "story_editorial_agent",
      "order": 3,
      "artifact": "script_candidate",
      "approval_domain": "editorial",
      "can_start_engine": false
    },
    {
      "id": "rights_provenance_agent",
      "order": 4,
      "artifact": "rights_ledger",
      "approval_domain": "rights",
      "can_start_engine": false
    },
    {
      "id": "visual_continuity_agent",
      "order": 5,
      "artifact": "visual_map",
      "approval_domain": "continuity",
      "can_start_engine": false
    },
    {
      "id": "timeline_caption_agent",
      "order": 6,
      "artifact": "timeline_preflight",
      "approval_domain": "timeline",
      "can_start_engine": false
    },
    {
      "id": "qa_release_reviewer",
      "order": 7,
      "artifact": "qa_receipt",
      "approval_domain": "release_qa",
      "can_start_engine": false
    },
    {
      "id": "delivery_agent",
      "order": 8,
      "artifact": "delivery_package",
      "approval_domain": "delivery",
      "can_start_engine": false
    }
  ],
  "required_output_fields": [
    "agent_id",
    "input_revision",
    "source_artifacts",
    "evidence",
    "status",
    "blocking_reasons",
    "output_artifact",
    "output_sha256",
    "next_gate",
    "token_budget_used"
  ],
  "allowed_statuses": [
    "PASS",
    "EDIT",
    "BLOCKED",
    "FAIL"
  ],
  "production_activation": {
    "enabled": false,
    "requires_all_gates_pass": true,
    "requires_current_memory": true,
    "requires_human_approval_for_publication": true,
    "fallbacks_allowed": false
  },
  "queue_contract": {
    "module": "production/copilot_queue_v1.py",
    "state_file_role": "isolated_queue_snapshot",
    "persistence": "atomic_replace_with_fsync",
    "claim_policy": "EXACTLY_ONE_ACTIVE_RUN",
    "stale_context": "FAIL_CLOSED",
    "engine_activation": "DISABLED_IN_THIS_PR"
  },
  "executor_layer": {
    "module": "production/copilot_executor_registry_v1.py",
    "mode": "INJECTED_PROVIDER_REGISTRY",
    "provider_resolution": "EXPLICIT_MAPPING_BY_AGENT_ID",
    "missing_provider": "BLOCKED",
    "parallel": false,
    "network_allowed": false,
    "can_start_engine": false,
    "production_activation": "DISABLED"
  },
  "levels": {
    "analysis": {
      "level": 1,
      "id": "specialized_analysis",
      "dispatch": "SEQUENTIAL_ISOLATED_ARTIFACT",
      "adapter": "production/copilot_analysis_agents_v1.py",
      "parallel": false,
      "can_start_engine": false,
      "agents": [
        "research_analyst",
        "factual_reviewer",
        "story_editorial_agent",
        "rights_provenance_agent",
        "visual_continuity_agent",
        "timeline_caption_agent",
        "qa_release_reviewer",
        "delivery_agent"
      ],
      "required_status": "PASS",
      "description": "Six domain analysts followed by independent release QA and delivery packaging; all eight tasks remain sequential and production-disabled."
    },
    "technical_gate": {
      "level": 2,
      "id": "copilot_technical_gate",
      "module": "production/copilot_technical_gate_v1.py",
      "workflow": ".github/workflows/copilot-technical-gate.yml",
      "requires_level": "analysis",
      "consolidates": [
        "tests",
        "privacy",
        "scope",
        "compilation",
        "regressions"
      ],
      "parallel": false,
      "can_start_engine": false,
      "required_status": "PASS"
    }
  },
  "level_order": [
    "specialized_analysis",
    "copilot_technical_gate"
  ],
  "provider_readiness": {
    "module": "production/copilot_provider_readiness_v1.py",
    "metadata": "EXPLICIT_REGISTERED_PROVIDER",
    "preflight_before_dispatch": true,
    "network_allowed": false,
    "can_start_engine": false,
    "parallel": false,
    "estimated_cost_cents": 0,
    "missing_provider": "BLOCKED",
    "unsafe_manifest": "FAIL_CLOSED"
  },
  "brazil_files_crosswalk": {
    "module": "production/brazil_files_canonical_crosswalk_v1.py",
    "source_checkpoint_count": 22,
    "canonical_agent_count": 8,
    "execution_mode": "SEQUENTIAL_REUSE_CANONICAL_AGENT",
    "parallel": false,
    "secondary_engine": false,
    "terminal_agent": "delivery_agent"
  }
}
