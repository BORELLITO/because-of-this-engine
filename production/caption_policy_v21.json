{
  "policy_version": "1.0",
  "project": "Because Of This Stories",
  "runtime": "because_of_this_v21",
  "alignment": {
    "mode": "audio_final_forced_alignment",
    "source": "real_word_timestamps",
    "word_highlight_enabled": true,
    "word_highlight_mode": "timestamp_color_transform",
    "active_word_color": "#F04444",
