  "layout": {
    "max_lines": 2,
    "max_line_chars": 42,
    "alignment": 2,
    "margin_v": 650,
    "margin_l": 100,
    "margin_r": 100
  },
  "forbidden_caption_characters": ["—", "–"],
  "ordinary_internal_hyphen_allowed": true
}
